hidden_dissatisfaction:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('SILVER_DB_HOST', 'localhost') }}"
      port: "{{ env_var('SILVER_DB_PORT', '5432') | int }}"
      user: "{{ env_var('SILVER_DB_USER', 'postgres') }}"
      password: "{{ env_var('SILVER_DB_PASSWORD', '') }}"
      dbname: "{{ env_var('SILVER_DB_NAME', 'ironman') }}"
      schema: silver
      threads: 4
