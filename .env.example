COMPOSE_PROJECT_NAME=hidden_dissatisfaction_dev
POSTGRES_IMAGE=postgres:16.6-bookworm
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-before-first-start
POSTGRES_DB=hidden_dissatisfaction
POSTGRES_PORT=5432
HD_APP_RUNTIME_PASSWORD=change-me-app-runtime-password
HD_DATABASE_URL=postgresql+asyncpg://app_api:change-me-app-runtime-password@127.0.0.1:5432/hidden_dissatisfaction
HD_JWT_SECRET=replace-with-a-long-random-secret
HD_EVIDENCE_DIR=./data/evidence
API_PORT=8000
FRONTEND_PORT=4200
# Local-only synthetic demo account. Use a unique password; never deploy these values.
DEMO_USERNAME=demo_specialist
DEMO_PASSWORD=replace-with-a-unique-local-demo-password
DBT_USER=postgres
DBT_PASSWORD=change-me-before-first-start
# JSON list, e.g. ["http://localhost:4200"]; leave unset for same-origin only
# HD_CORS_ORIGINS=[]
